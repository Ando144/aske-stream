# Configuration for the ingest CLI (npm run ingest). Copy to `.env` — it is git-ignored.
# `npm run cf:setup` fills both values for you.

# Public URL of your deployment (no trailing slash)
ASKE_URL=https://aske-stream.<your-subdomain>.workers.dev

# Same value as the ACCESS_KEY Worker secret. Generate one with: npm run gen-key
ASKE_ACCESS_KEY=
