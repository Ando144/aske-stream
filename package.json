{
  "name": "aske-stream",
  "version": "0.2.1",
  "private": true,
  "description": "Self-hosted, Spotify-style music cloud: bring your own music, stream it from Cloudflare R2, keep a rotating offline cache on your phone.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @aske/web",
    "dev:api": "npm run dev -w @aske/api",
    "build": "npm run build -w @aske/web",
    "deploy": "npm run build && npm run deploy -w @aske/api",
    "android:apk": "npm run apk -w @aske/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build",
    "db:migrate:local": "npm run db:migrate:local -w @aske/api",
    "db:migrate:remote": "npm run db:migrate:remote -w @aske/api",
    "cf:setup": "node scripts/cf-setup.mjs",
    "gen-key": "node scripts/gen-key.mjs",
    "ingest": "npm run start --silent -w @aske/ingest --"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
