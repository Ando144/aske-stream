# Dependencies
node_modules/

# Builds
dist/
dev-dist/
*.tsbuildinfo

# Secrets — never commit these
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
cookies.txt
*.cookies

# Cloudflare / Wrangler local state
.wrangler/

# Ingest tool scratch space
.ingest-tmp/
tools/ingest/tmp/
.ingest-out/

# Logs & OS / editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Media files never belong in git (they live in R2)
*.opus
*.ogg
*.webm
*.m4a
*.mp3
*.flac
*.wav
